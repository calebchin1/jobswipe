# Server-side Next.js settings. Copy to apps/web/.env.local for local development.
# A publishable key is required; never use a service-role/secret key in user requests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact public origin, mandatory outside loopback; HTTPS for deployed environments.
APP_ORIGIN=http://localhost:3000
# Optional comma-separated browser preview origins allowed to send Bearer tokens.
# Cookie authentication remains same-origin. Native iOS/Android needs no CORS entry.
ALLOWED_CLIENT_ORIGINS=http://localhost:8081
# Optional server-only audio interview service. Never put these in EXPO_PUBLIC_*.
# Selected cloud project: p_257tohbuho0.
# LIVEKIT_URL is the wss:// Project URL from LiveKit settings, not its dashboard URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
