{
  "name": "swipe-to-hire",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs web dev",
    "dev:mobile": "node scripts/run.mjs mobile start",
    "build": "node scripts/run.mjs web build",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:db": "bash supabase/tests/run.sh",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:mobile": "node scripts/run.mjs mobile export --platform web && node node_modules/@playwright/test/cli.js test --config playwright.candidate.config.ts",
    "check": "node scripts/typecheck.mjs && node node_modules/vitest/vitest.mjs run",
    "test:connected": "node scripts/run-connected-tests.mjs",
    "test:web-live": "node node_modules/@playwright/test/cli.js test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "prettier": "3.9.9",
    "pg": "8.23.0",
    "@types/pg": "8.23.1",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
